#
# The library's configuration for the consumers of the NoxTLS targets.
#
# The NOXTLS_* settings of CMakeLists.txt (features, static memory, profiles, the
# ABI layout id) are directory compile definitions, so they reach only targets
# defined under this source tree. A target elsewhere that links NoxTLS would
# compile the NoxTLS headers with its own values (and fail to link on the ABI
# fingerprint, noxtls-lib/tls/noxtls_abi.h).
#
# noxtls_build_config_generate() writes noxtls_build_config.h in the build tree:
# for every NOXTLS_* directory definition an #undef and a #define of the
# library's value, and an #undef for each CMake-owned setting the library leaves
# undefined. noxtls_build_config_export() makes the NoxTLS library targets pass
# NOXTLS_BUILD_CONFIG=1 and that header's directory to every consumer outside
# this source tree; noxtls_config.h then includes the header first, so the
# consumer sees exactly the library's values whatever its own definitions say.
# Targets under this tree compile with the definitions themselves (and keep
# their deliberate PRIVATE deviations); a target there can still opt in with
# the target property NOXTLS_BUILD_CONFIG_SKIP set to OFF.

# Settings that only CMake sets: undefined in the library means undefined for
# every consumer too.
set(_NOXTLS_BUILD_CONFIG_OWNED
  NOXTLS_CONFIG_STATIC_MEMORY
  NOXTLS_STATIC_CONNECTION_POOL_COUNT
  NOXTLS_STATIC_MEMORY_PROFILE
  NOXTLS_PROFILE_MINIMAL_TLS_CLIENT
  NOXTLS_PROFILE_TLS_SERVER_PKI
  NOXTLS_PROFILE_CRYPTO_ONLY
  NOXTLS_PROFILE_FIPS_LIKE
  NOXTLS_SIDECHANNEL_PROFILE_PERFORMANCE
  NOXTLS_SIDECHANNEL_PROFILE_BALANCED
  NOXTLS_SIDECHANNEL_PROFILE_CONSTANT_TIME_STRICT
)

# Write noxtls_build_config.h from this directory's compile definitions; sets
# NOXTLS_BUILD_CONFIG_DIR in the caller's scope.
function(noxtls_build_config_generate)
  set(_dir "${CMAKE_CURRENT_BINARY_DIR}/noxtls_build_config")
  get_directory_property(_definitions COMPILE_DEFINITIONS)
  set(_text "/* Generated by cmake/noxtls_build_config.cmake: the configuration the NoxTLS\n")
  string(APPEND _text " * library is built with, for the consumers of its CMake targets. Do not edit. */\n")
  string(APPEND _text "#ifndef NOXTLS_BUILD_CONFIG_H_\n#define NOXTLS_BUILD_CONFIG_H_\n")
  set(_defined "")
  foreach(_definition IN LISTS _definitions)
    if(_definition MATCHES "^(NOXTLS_[A-Za-z0-9_]+)(=.*)?$")
      set(_name "${CMAKE_MATCH_1}")
      string(FIND "${_definition}" "=" _eq)
      if(_eq EQUAL -1)
        set(_value "1")
      else()
        math(EXPR _start "${_eq} + 1")
        string(SUBSTRING "${_definition}" ${_start} -1 _value)
      endif()
      list(APPEND _defined "${_name}")
      string(APPEND _text "#undef ${_name}\n#define ${_name} ${_value}\n")
    endif()
  endforeach()
  foreach(_name IN LISTS _NOXTLS_BUILD_CONFIG_OWNED)
    list(FIND _defined "${_name}" _found)
    if(_found EQUAL -1)
      string(APPEND _text "#undef ${_name}\n")
    endif()
  endforeach()
  string(APPEND _text "#endif /* NOXTLS_BUILD_CONFIG_H_ */\n")
  # configure_file() rewrites the header only when its content changes.
  file(WRITE "${_dir}/noxtls_build_config.h.in" "${_text}")
  configure_file("${_dir}/noxtls_build_config.h.in" "${_dir}/noxtls_build_config.h" COPYONLY)
  set(NOXTLS_BUILD_CONFIG_DIR "${_dir}" PARENT_SCOPE)
endfunction()

# Mark every target defined under @p dir (recursively) as part of this source
# tree, unless it set NOXTLS_BUILD_CONFIG_SKIP itself.
function(_noxtls_build_config_mark_tree dir)
  get_property(_targets DIRECTORY "${dir}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(_target IN LISTS _targets)
    get_target_property(_type "${_target}" TYPE)
    if(_type MATCHES "^(EXECUTABLE|STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY)$")
      get_property(_set TARGET "${_target}" PROPERTY NOXTLS_BUILD_CONFIG_SKIP SET)
      if(NOT _set)
        set_property(TARGET "${_target}" PROPERTY NOXTLS_BUILD_CONFIG_SKIP ON)
      endif()
    endif()
  endforeach()
  get_property(_subdirs DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
  foreach(_subdir IN LISTS _subdirs)
    _noxtls_build_config_mark_tree("${_subdir}")
  endforeach()
endfunction()

# Pass the configuration of noxtls_build_config_generate() to the consumers of
# the given library targets. Call after every target of this tree is defined.
function(noxtls_build_config_export)
  foreach(_lib IN LISTS ARGN)
    if(TARGET "${_lib}")
      set_property(TARGET "${_lib}" APPEND PROPERTY INTERFACE_COMPILE_DEFINITIONS
        "$<$<NOT:$<BOOL:$<TARGET_PROPERTY:NOXTLS_BUILD_CONFIG_SKIP>>>:NOXTLS_BUILD_CONFIG=1>")
      set_property(TARGET "${_lib}" APPEND PROPERTY INTERFACE_INCLUDE_DIRECTORIES
        "$<BUILD_INTERFACE:${NOXTLS_BUILD_CONFIG_DIR}>")
    endif()
  endforeach()
  _noxtls_build_config_mark_tree("${CMAKE_CURRENT_SOURCE_DIR}")
endfunction()
