{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/argenox/noxtls/docs/changelog.schema.json",
  "title": "NoxTLS changelog",
  "description": "Release history. The docs site reads version, date, changes, fixed and known_issues. Release packaging (noxtls-oem) also reads the optional quality-record fields: summary, highlights, breaking_changes, anomalies, resolved, security and security_recommendations.",
  "type": "object",
  "required": ["releases"],
  "additionalProperties": false,
  "properties": {
    "releases": {
      "type": "array",
      "description": "Newest release first.",
      "items": { "$ref": "#/$defs/release" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "release": {
      "type": "object",
      "required": ["version", "date", "changes", "fixed", "known_issues"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "date": { "type": "string", "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}|[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}|TBD)$", "description": "YYYY-MM-DD. Older entries use M/D/YYYY or TBD; check_changelog.py requires YYYY-MM-DD from 0.3.15 on." },
        "changes": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "fixed": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "known_issues": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "summary": { "$ref": "#/$defs/text", "description": "One paragraph for the release summary document." },
        "highlights": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "breaking_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["change", "migration"],
            "additionalProperties": false,
            "properties": {
              "change": { "$ref": "#/$defs/text" },
              "migration": { "$ref": "#/$defs/text" }
            }
          }
        },
        "anomalies": {
          "type": "array",
          "description": "Known anomalies in this release. When present, it supersedes known_issues for quality records.",
          "items": {
            "type": "object",
            "required": ["id", "title", "description", "severity", "workaround", "status", "introduced_in"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^NOXTLS-KA-[0-9A-Za-z.-]+$" },
              "title": { "$ref": "#/$defs/text" },
              "description": { "$ref": "#/$defs/text" },
              "severity": { "enum": ["low", "medium", "high"] },
              "workaround": { "$ref": "#/$defs/text" },
              "status": { "enum": ["open", "accepted", "monitoring"] },
              "introduced_in": { "$ref": "#/$defs/text" }
            }
          }
        },
        "resolved": {
          "type": "array",
          "description": "Issues resolved in this release. When present, it supersedes fixed for quality records.",
          "items": {
            "type": "object",
            "required": ["id", "title", "description", "refs"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^NOXTLS-RI-[0-9A-Za-z.-]+$" },
              "title": { "$ref": "#/$defs/text" },
              "description": { "$ref": "#/$defs/text" },
              "refs": { "type": "array", "items": { "$ref": "#/$defs/text" } }
            }
          }
        },
        "security": {
          "type": "array",
          "description": "Security-relevant fixes and advisories in this release.",
          "items": {
            "type": "object",
            "required": ["id", "severity", "title", "description", "affected_versions", "cve"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^NOXTLS-SA-[0-9A-Za-z.-]+$" },
              "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
              "title": { "$ref": "#/$defs/text" },
              "description": { "$ref": "#/$defs/text" },
              "affected_versions": { "$ref": "#/$defs/text" },
              "cve": { "type": ["string", "null"] }
            }
          }
        },
        "security_recommendations": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "deprecations": {
          "type": "array",
          "description": "Deprecated APIs, options or behaviour in this release.",
          "items": {
            "type": "object",
            "required": ["item", "replacement", "removal"],
            "additionalProperties": false,
            "properties": {
              "item": { "$ref": "#/$defs/text" },
              "replacement": { "$ref": "#/$defs/text" },
              "removal": { "$ref": "#/$defs/text", "description": "When removal is planned, or why it is kept." }
            }
          }
        }
      }
    }
  }
}
